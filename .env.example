TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-haiku-5-5

# Необязательно: уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Открывать страницы товаров в headless Chromium, если обычный запрос не дал данных
BROWSER_RENDERING=true

# Память диалога: сколько последних реплик видит модель
SHORT_MEMORY_MESSAGES=10
# После скольких реплик старая часть истории сворачивается в резюме (0 — выключить)
SHORT_MEMORY_SUMMARY_AFTER=20

# Доступ по токенам-приглашениям: метка:токен через запятую.
# Каждый токен привязывается к одному аккаунту Telegram при первой активации.
# Сгенерировать токен: python -c "import secrets; print(secrets.token_urlsafe(24))"
ACCESS_TOKENS=owner:your_owner_token,teacher:your_teacher_token

# Лимиты на пользователя
PDF_PER_HOUR=10
CHAT_PER_HOUR=30
# Через сколько дней удалять PDF и JSON с диска
FILE_RETENTION_DAYS=7
# Через сколько часов неактивности забывать историю переписки
MEMORY_IDLE_HOURS=6
